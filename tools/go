#!/bin/sh
# Saves test results to the stick and turns sleep off (the firmware has no working sleep yet).
# Recovery Terminal:  sh /Volumes/OPENCORE/go      Installed macOS:  sudo sh /Volumes/OPENCORE/go
cd /Volumes/OPENCORE || exit 1
pmset -a sleep 0 standby 0 hibernatemode 0 powernap 0 disksleep 0 2>/dev/null && echo "sleep turned off"
echo "saving, about 30 seconds..."
ioreg -l -w0 > ioreg-full.txt
kmutil showloaded > kexts.txt 2>&1
diskutil list > disks.txt
sysctl hw.logicalcpu hw.model machdep.cpu.brand_string kern.osversion > sysctl.txt
sw_vers > swvers.txt 2>&1
ls /Volumes > volumes.txt
dmesg > dmesg.txt 2>&1
pmset -g > pmset.txt 2>&1
system_profiler SPDisplaysDataType SPUSBDataType SPAudioDataType SPNetworkDataType > profile.txt 2>&1
sync
ls -la
echo "DONE - now Apple menu > Shut Down"
